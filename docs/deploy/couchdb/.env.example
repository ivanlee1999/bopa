# Copy to .env and fill in. Keep .env off git — it holds real credentials.

# Admin account. Used for setup and maintenance only; the apps never see it.
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=

# The account the iPad and BOOX actually use. Non-admin, scoped to the notes database.
COUCHDB_SYNC_USER=sync
COUCHDB_SYNC_PASSWORD=

# Any long random string; only matters if you ever cluster.
COUCHDB_ERLANG_COOKIE=

# Where the apps will reach the server. During setup this can be http://<nas-ip>:5984.
COUCHDB_URL=https://couch.liyifan.us
COUCHDB_DATABASE=notes

# Recognized handwriting. A separate database on purpose: the sync engines never
# open it, so its documents can change shape without touching the sync protocol,
# and an app build that knows nothing about them is unaffected.
COUCHDB_TEXT_DATABASE=notes_text
